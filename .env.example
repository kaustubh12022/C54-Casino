# ─────────────────────────────────────────────────────────────────────────────
# C54 Casino — local environment template
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit a filled-in copy and never paste a real
# password into this file — it is a template, placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Schema / DDL connection (init_tables.js) ─────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# Use the DIRECT connection for DDL (CREATE TABLE / CREATE POLICY /
# ALTER PUBLICATION):
#   DATABASE_URL=postgresql://postgres.<user>:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Use the SESSION POOLER for everything else (app traffic, long-lived scripts):
#   DATABASE_URL=postgresql://postgres.<user>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# The alternative variable name below is also accepted by init_tables.js.
DATABASE_URL=postgresql://postgres.<user>:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Test-only connection (test_suite.js) ─────────────────────────────────────
# The test suite MUST point at an isolated test database, never at production.
# The name or the host has to contain the word "test" (case-insensitive), e.g.
#   TEST_DATABASE_URL=postgresql://postgres.<user>:<password>@db.<project-ref>.supabase.co:5432/c54_test
# The suite refuses to run against db.ixczvfnzttmiecgqoiek.supabase.co.
TEST_DATABASE_URL=postgresql://postgres.<user>:<password>@db.<project-ref>.supabase.co:5432/c54_test

# ── Runtime overrides for the browser app (optional) ─────────────────────────
# supabase-config.js reads window.__ENV__ first and falls back to the values
# baked into the file. Define window.__ENV__ before supabase-config.js loads to
# repoint the app at another project without a rebuild:
#   <script>window.__ENV__ = { SUPABASE_URL: "https://<ref>.supabase.co", SUPABASE_ANON_KEY: "<anon key>" };</script>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# ── Escape hatches (rarely needed) ───────────────────────────────────────────
# Set to 1 to let init_tables.js touch the production schema on purpose.
# ALLOW_PRODUCTION_SCHEMA=1
#
# Set to 1 to let test_suite.js connect to a non-production database whose
# host/name does not contain the word "test". It can NEVER unlock production.
# ALLOW_NON_MARKERED_TEST_DB=1
